# ============================================
# Bean & Brew OS - Development Dockerfile
# With hot-reload support
# ============================================

FROM node:20-alpine AS development

# Install OpenSSL and curl for Prisma
RUN apk add --no-cache openssl curl git

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm install

# Install Prisma CLI globally
RUN npm install -g prisma

# Copy source code
COPY . .

# Generate Prisma client
RUN npx prisma generate

# Expose port
EXPOSE 3000

# Start with dev mode (hot-reload)
CMD ["npm", "run", "dev"]
