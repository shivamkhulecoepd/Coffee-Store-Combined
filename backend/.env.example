# ============================================
# Bean & Brew OS Backend - Environment Variables
# ============================================

# Server Configuration
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# ============================================
# Docker Configuration (used by docker-compose)
# ============================================
# PostgreSQL
POSTGRES_USER=beanbrew
POSTGRES_PASSWORD=beanbrew_secret
POSTGRES_DB=beanbrew
POSTGRES_PORT=5432

# Redis
REDIS_PASSWORD=redis_secret
REDIS_PORT=6379

# pgAdmin (optional)
PGADMIN_EMAIL=admin@beanbrew.local
PGADMIN_PASSWORD=admin123
PGADMIN_PORT=5050

# Frontend URL
FRONTEND_URL=http://localhost:5173

# ============================================
# Database (PostgreSQL)
# ============================================
# Local development:
DATABASE_URL=postgresql://beanbrew:beanbrew_secret@localhost:5432/beanbrew

# Docker (use service name as hostname):
# DATABASE_URL=postgresql://beanbrew:beanbrew_secret@postgres:5432/beanbrew

# ============================================
# Redis
# ============================================
# Local development:
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_secret

# Docker (use service name as hostname):
# REDIS_HOST=redis
# REDIS_URL=redis://:redis_secret@redis:6379

# ============================================
# JWT Authentication
# IMPORTANT: Change these in production! Use 64+ character random strings
# ============================================
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-minimum-32-characters-change-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ============================================
# Argon2 Password Hashing
# ============================================
ARGON2_SALT_LENGTH=16
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4

# ============================================
# CORS (comma-separated origins)
# ============================================
# For local development:
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# For Docker frontend:
# CORS_ORIGIN=http://localhost:5173

# ============================================
# OTP Configuration
# ============================================
OTP_EXPIRES_IN_MINUTES=10
OTP_LENGTH=6

# ============================================
# Rate Limiting
# ============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# Logging
# ============================================
LOG_LEVEL=info
LOG_DIR=./logs

# ============================================
# AWS S3 (Optional - for file uploads)
# ============================================
# S3_BUCKET=bean-brew-uploads
# S3_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_ENDPOINT= (for S3-compatible services like MinIO)

# ============================================
# Email (Optional - for sending emails)
# ============================================
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=noreply@beanandbrew.com

# ============================================
# Stripe Payment (Optional)
# ============================================
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# ============================================
# Development Notes
# ============================================
# 1. Copy this file to .env and fill in your values
# 2. For Docker: docker-compose up -d
# 3. For local: Ensure PostgreSQL and Redis are running
# 4. Run 'npm run prisma:generate' after changing schema
# 5. Run 'npm run prisma:migrate' to create tables
# 6. For production, use proper secrets management
